#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* next;

    Node(int val) {
        data = val;
        next = NULL;
    }
};

class LinkedList {
private:
    Node* head;

public:
    LinkedList() {
        head = NULL;
    }

    void insert(int val) {
        Node* newNode = new Node(val);
        if (!head) {
            head = newNode;
            return;
        }

        Node* temp = head;
        while (temp->next)
            temp = temp->next;

        temp->next = newNode;
    }

    void display() {
        Node* temp = head;
        while (temp) {
            cout << temp->data << " -> ";
            temp = temp->next;
        }
        cout << "NULL\n";
    }

    void rotate(int k) {
        if (!head || k == 0)
            return;

        // Find length and last node
        Node* temp = head;
        int length = 1;

        while (temp->next) {
            temp = temp->next;
            length++;
        }

        k = k % length;
        if (k == 0)
            return;

        // Make circular
        temp->next = head;

        // Find new tail
        int stepsToNewHead = length - k;
        Node* newTail = head;

        for (int i = 1; i < stepsToNewHead; i++) {
            newTail = newTail->next;
        }

        head = newTail->next;
        newTail->next = NULL;
    }
};

int main() {
    LinkedList list;
    int n, value, k;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++) {
        cin >> value;
        list.insert(value);
    }

    cout << "Enter rotation value (k): ";
    cin >> k;

    cout << "\nOriginal List:\n";
    list.display();

    list.rotate(k);

    cout << "\nRotated List:\n";
    list.display();

    return 0;
}