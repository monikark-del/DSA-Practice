#include <iostream>
using namespace std;

struct ListNode {
    int val;
    ListNode* next;
    ListNode(int x) : val(x), next(NULL) {}
};

ListNode* mergeNodesBetweenMarkers(ListNode* head) {
    ListNode dummy(0);
    ListNode* tail = &dummy;

    int sum = 0;
    ListNode* curr = head->next; // skip first -1

    while (curr) {
        if (curr->val == -1) {
            tail->next = new ListNode(sum);
            tail = tail->next;
            sum = 0;
        } else {
            sum += curr->val;
        }
        curr = curr->next;
    }

    return dummy.next;
}
