/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */

class Solution {
public:
    vector<ListNode*> splitListToParts(ListNode* head, int k) {
        vector<ListNode*> result(k, NULL);

        // Step 1: Count nodes
        int n = 0;
        ListNode* temp = head;
        while (temp) {
            n++;
            temp = temp->next;
        }

        int partSize = n / k;
        int extra = n % k;

        ListNode* curr = head;

        // Step 2: Split into k parts
        for (int i = 0; i < k && curr; i++) {
            result[i] = curr;
            int size = partSize + (extra > 0 ? 1 : 0);
            extra--;

            for (int j = 1; j < size; j++)
                curr = curr->next;

            ListNode* nextPart = curr->next;
            curr->next = NULL;
            curr = nextPart;
        }

        return result;
    }
};
