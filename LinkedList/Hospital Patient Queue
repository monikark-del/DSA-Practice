#include <iostream>
using namespace std;

struct Patient {
    int id;
    string name;
    int priority; // 1-High, 2-Medium, 3-Low
    Patient* next;
};

Patient* head = NULL;

// Insert patient based on priority
void addPatient(int id, string name, int priority) {
    Patient* newPatient = new Patient;
    newPatient->id = id;
    newPatient->name = name;
    newPatient->priority = priority;
    newPatient->next = NULL;

    // If list empty or high priority
    if(head == NULL || priority < head->priority) {
        newPatient->next = head;
        head = newPatient;
    } else {
        Patient* temp = head;
        while(temp->next != NULL && temp->next->priority <= priority) {
            temp = temp->next;
        }
        newPatient->next = temp->next;
        temp->next = newPatient;
    }

    cout << "Patient Added Successfully!\n";
}

// Treat patient (remove highest priority)
void treatPatient() {
    if(head == NULL) {
        cout << "No patients in queue!\n";
        return;
    }

    Patient* temp = head;
    cout << "Treating Patient: " << temp->name << " (Priority " << temp->priority << ")\n";
    head = head->next;
    delete temp;
}

// Display patient list
void displayPatients() {
    if(head == NULL) {
        cout << "No patients in queue!\n";
        return;
    }

    Patient* temp = head;
    cout << "\n--- Patient Queue ---\n";
    while(temp != NULL) {
        cout << "ID: " << temp->id
             << " | Name: " << temp->name
             << " | Priority: " << temp->priority << endl;
        temp = temp->next;
    }
}

int main() {
    int choice, id, priority;
    string name;

    do {
        cout << "\n1. Add Patient";
        cout << "\n2. Treat Patient";
        cout << "\n3. Display Patients";
        cout << "\n4. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch(choice) {
            case 1:
                cout << "Enter Patient ID: ";
                cin >> id;
                cin.ignore();
                cout << "Enter Patient Name: ";
                getline(cin, name);
                cout << "Enter Priority (1-High, 2-Medium, 3-Low): ";
                cin >> priority;
                addPatient(id, name, priority);
                break;

            case 2:
                treatPatient();
                break;

            case 3:
                displayPatients();
                break;

            case 4:
                cout << "Exiting...\n";
                break;

            default:
                cout << "Invalid choice!\n";
        }

    } while(choice != 4);

    return 0;
}