#include <iostream>
using namespace std;

class Node {
public:
    int roll;
    string name;
    Node* next;

    Node(int r, string n) {
        roll = r;
        name = n;
        next = NULL;
    }
};

class LinkedList {
    Node* head;

public:
    LinkedList() {
        head = NULL;
    }

    void insert(int roll, string name) {
        Node* newNode = new Node(roll, name);

        if (head == NULL) {
            head = newNode;
            return;
        }

        Node* temp = head;
        while (temp->next != NULL) {
            temp = temp->next;
        }
        temp->next = newNode;
    }

    void deleteNode(int roll) {
        if (head == NULL) return;

        if (head->roll == roll) {
            Node* temp = head;
            head = head->next;
            delete temp;
            return;
        }

        Node* temp = head;
        while (temp->next != NULL && temp->next->roll != roll) {
            temp = temp->next;
        }

        if (temp->next == NULL) return;

        Node* toDelete = temp->next;
        temp->next = temp->next->next;
        delete toDelete;
    }

    void display() {
        Node* temp = head;
        while (temp != NULL) {
            cout << "Roll: " << temp->roll << ", Name: " << temp->name << " -> ";
            temp = temp->next;
        }
        cout << "NULL" << endl;
    }
};

int main() {
    LinkedList list;

    list.insert(101, "Alice");
    list.insert(102, "Bob");
    list.insert(103, "Charlie");

    cout << "Student List: ";
    list.display();

    cout << "After deleting roll 102: ";
    list.deleteNode(102);
    list.display();

    return 0;
}