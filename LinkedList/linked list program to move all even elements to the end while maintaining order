#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* next;
};

// Function to append node at the end
void append(Node*& head, int value) {
    Node* newNode = new Node{value, nullptr};
    if (!head) {
        head = newNode;
        return;
    }
    Node* temp = head;
    while (temp->next)
        temp = temp->next;
    temp->next = newNode;
}

// Function to move all even elements to the end
void moveEvenToEnd(Node*& head) {
    if (!head || !head->next) return;

    Node* end = head;
    Node* prev = nullptr;
    Node* curr = head;

    // Find the last node
    while (end->next)
        end = end->next;
    Node* newEnd = end;

    while (curr != end->next) {
        if (curr->data % 2 == 0) {
            Node* temp = curr;
            if (curr == head) {
                head = head->next;
                curr = head;
            } else {
                prev->next = curr->next;
                curr = prev->next;
            }
            newEnd->next = temp;
            temp->next = nullptr;
            newEnd = temp;
        } else {
            prev = curr;
            curr = curr->next;
        }
    }
}

// Function to print the linked list
void printList(Node* head) {
    while (head) {
        cout << head->data << " -> ";
        head = head->next;
    }
    cout << "NULL\n";
}

int main() {
    Node* head = nullptr;

    append(head, 1);
    append(head, 2);
    append(head, 3);
    append(head, 4);
    append(head, 5);
    append(head, 6);

    cout << "Original List: ";
    printList(head);

    moveEvenToEnd(head);

    cout << "After moving even elements to end: ";
    printList(head);

    return 0;
}