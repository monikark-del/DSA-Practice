#include <iostream>
#include <queue>
using namespace std;

void firstNonRepeating(string stream) {
    queue<char> q;
    int freq[26] = {0};

    for(char ch : stream) {
        freq[ch - 'a']++;
        q.push(ch);

        // Remove repeating characters from front
        while(!q.empty() && freq[q.front() - 'a'] > 1) {
            q.pop();
        }

        if(q.empty())
            cout << "# ";
        else
            cout << q.front() << " ";
    }
}

int main() {
    string stream = "aabc";

    firstNonRepeating(stream);

    return 0;
}