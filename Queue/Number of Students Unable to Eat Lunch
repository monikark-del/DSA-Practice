class Solution {
public:
    int countStudents(vector<int>& students, vector<int>& sandwiches) {
        queue<int> q;
        for (int s : students)
            q.push(s);

        int index = 0;
        int rotations = 0;

        while (!q.empty() && rotations < q.size()) {
            if (q.front() == sandwiches[index]) {
                q.pop();
                index++;
                rotations = 0;
            } else {
                q.push(q.front());
                q.pop();
                rotations++;
            }
        }

        return q.size();
    }
};
