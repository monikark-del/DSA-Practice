#include <iostream>
#include <queue>
using namespace std;

class BankQueue {
    queue<string> q;

public:
    void addCustomer(string name) {
        q.push(name);
        cout << "Customer added: " << name << endl;
    }

    void serveCustomer() {
        if (q.empty()) {
            cout << "No customers in queue!" << endl;
            return;
        }
        cout << "Serving customer: " << q.front() << endl;
        q.pop();
    }

    void showQueue() {
        if (q.empty()) {
            cout << "No customers in queue!" << endl;
            return;
        }

        cout << "Customers in queue: ";
        queue<string> temp = q;
        while (!temp.empty()) {
            cout << temp.front() << " ";
            temp.pop();
        }
        cout << endl;
    }
};

int main() {
    BankQueue bq;

    bq.addCustomer("Amit");
    bq.addCustomer("Rahul");
    bq.addCustomer("Sita");

    bq.showQueue();

    bq.serveCustomer();
    bq.showQueue();

    bq.serveCustomer();
    bq.showQueue();

    return 0;
}