#include <queue>
#include <vector>
using namespace std;

int finishTime(vector<int>& arrival, vector<int>& load) {
    queue<pair<int,int>> q;
    int currentTime = 0;

    for (int i = 0; i < arrival.size(); i++) {
        q.push({arrival[i], load[i]});
    }

    while (!q.empty()) {
        auto truck = q.front();
        q.pop();

        if (currentTime < truck.first) {
            currentTime = truck.first;
        }

        currentTime += truck.second;
    }

    return currentTime;
}
