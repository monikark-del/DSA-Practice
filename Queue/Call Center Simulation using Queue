#include <iostream>
#include <queue>
using namespace std;

struct Customer {
    int callID;
    string name;
    string issue;
};

int main() {
    queue<Customer> callQueue;
    int choice;
    int handledCalls = 0;

    do {
        cout << "\n--- Call Center Menu ---\n";
        cout << "1. New Incoming Call\n";
        cout << "2. Attend Next Call\n";
        cout << "3. Show Waiting Calls\n";
        cout << "4. Show Total Calls Handled\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        if (choice == 1) {
            Customer c;
            cout << "Enter Call ID: ";
            cin >> c.callID;
            cout << "Enter Customer Name: ";
            cin >> c.name;
            cout << "Enter Issue Type: ";
            cin >> c.issue;

            callQueue.push(c);
            cout << "Call added to queue.\n";
        }

        else if (choice == 2) {
            if (callQueue.empty()) {
                cout << "No calls waiting.\n";
            } else {
                Customer c = callQueue.front();
                callQueue.pop();

                cout << "Attending Call ID: " << c.callID
                     << "\nCustomer: " << c.name
                     << "\nIssue: " << c.issue << endl;

                handledCalls++;
            }
        }

        else if (choice == 3) {
            if (callQueue.empty()) {
                cout << "No waiting calls.\n";
            } else {
                queue<Customer> temp = callQueue;
                cout << "\nWaiting Calls:\n";
                while (!temp.empty()) {
                    cout << "Call ID: " << temp.front().callID
                         << " | Name: " << temp.front().name
                         << " | Issue: " << temp.front().issue << endl;
                    temp.pop();
                }
            }
        }

        else if (choice == 4) {
            cout << "Total Calls Handled: " << handledCalls << endl;
        }

    } while (choice != 5);

    cout << "System Closed.\n";
    return 0;
}