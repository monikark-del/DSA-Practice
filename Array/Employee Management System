#include <iostream>
using namespace std;

const int MAX = 50;

class Employee {
public:
    int id;
    string name;
    float salary;
};

Employee emp[MAX];
int total = 0;

void addEmployee() {
    if (total >= MAX) {
        cout << "Employee list is full!\n";
        return;
    }

    cout << "\nEnter Employee ID: ";
    cin >> emp[total].id;

    cout << "Enter Employee Name: ";
    cin >> emp[total].name;

    cout << "Enter Salary: ";
    cin >> emp[total].salary;

    total++;
    cout << "Employee Added Successfully!\n";
}

void displayEmployees() {
    if (total == 0) {
        cout << "\nNo Employees Found!\n";
        return;
    }

    cout << "\n--- Employee Details ---\n";
    for (int i = 0; i < total; i++) {
        cout << "\nID: " << emp[i].id;
        cout << "\nName: " << emp[i].name;
        cout << "\nSalary: " << emp[i].salary << "\n";
    }
}

void highestSalary() {
    if (total == 0) {
        cout << "\nNo data available!\n";
        return;
    }

    int index = 0;
    for (int i = 1; i < total; i++) {
        if (emp[i].salary > emp[index].salary) {
            index = i;
        }
    }

    cout << "\nEmployee with Highest Salary:\n";
    cout << "ID: " << emp[index].id << endl;
    cout << "Name: " << emp[index].name << endl;
    cout << "Salary: " << emp[index].salary << endl;
}

void updateSalary() {
    int id, found = 0;
    cout << "\nEnter Employee ID to Update Salary: ";
    cin >> id;

    for (int i = 0; i < total; i++) {
        if (emp[i].id == id) {
            cout << "Enter New Salary: ";
            cin >> emp[i].salary;
            cout << "Salary Updated Successfully!\n";
            found = 1;
            break;
        }
    }

    if (!found)
        cout << "Employee Not Found!\n";
}

int main() {
    int choice;

    do {
        cout << "\n\n===== Employee Management (Array) =====\n";
        cout << "1. Add Employee\n";
        cout << "2. Display Employees\n";
        cout << "3. Find Highest Salary\n";
        cout << "4. Update Salary\n";
        cout << "5. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: addEmployee(); break;
            case 2: displayEmployees(); break;
            case 3: highestSalary(); break;
            case 4: updateSalary(); break;
            case 5: cout << "Exiting...\n"; break;
            default: cout << "Invalid Choice!\n";
        }

    } while (choice != 5);

    return 0;
}