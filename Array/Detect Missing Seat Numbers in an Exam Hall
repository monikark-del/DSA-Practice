#include <iostream>
using namespace std;

int main() {
    int n, present;

    cout << "Enter total seats: ";
    cin >> n;

    int seats[n+1] = {0};

    cout << "Enter number of students present: ";
    cin >> present;

    cout << "Enter the seat numbers of present students:\n";
    for(int i = 0; i < present; i++) {
        int seat;
        cin >> seat;
        seats[seat] = 1;
    }

    cout << "\nAbsent seat numbers are:\n";
    for(int i = 1; i <= n; i++) {
        if(seats[i] == 0) {
            cout << i << " ";
        }
    }

    return 0;
}