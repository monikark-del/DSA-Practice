#include <iostream>
using namespace std;

void findEquilibrium(int arr[], int n) {
    int totalSum = 0;

    // Step 1: Find total sum
    for(int i = 0; i < n; i++) {
        totalSum += arr[i];
    }

    int leftSum = 0;
    bool found = false;

    // Step 2: Traverse array
    for(int i = 0; i < n; i++) {

        totalSum -= arr[i];  // Now totalSum becomes rightSum

        if(leftSum == totalSum) {
            cout << "Equilibrium index: " << i << endl;
            found = true;
        }

        leftSum += arr[i];
    }

    if(!found) {
        cout << "-1" << endl;
    }
}

int main() {
    int arr[] = {1, 3, 5, 2, 2};
    int n = sizeof(arr) / sizeof(arr[0]);

    findEquilibrium(arr, n);

    return 0;
}