class Solution {
    public int maxProfit(int[] prices) {
        
        int first=prices[0];
        int maxi=0;

        for(int i=1;i<prices.length;i++)
        {
            first=Math.min(first,prices[i]);
            maxi=Math.max(maxi,prices[i]-first);
        }
        return maxi;
    }
}
