#include <iostream>
#include <unordered_map>
using namespace std;

int longestBalancedSubarray(int arr[], int n) {
    unordered_map<int, int> prefixMap;
    int sum = 0;
    int maxLength = 0;

    prefixMap[0] = -1;  // Important for full array case

    for(int i = 0; i < n; i++) {
        // Convert 0 to -1
        if(arr[i] == 0)
            sum += -1;
        else
            sum += 1;

        // If sum seen before, calculate length
        if(prefixMap.find(sum) != prefixMap.end()) {
            int length = i - prefixMap[sum];
            if(length > maxLength)
                maxLength = length;
        } else {
            prefixMap[sum] = i;
        }
    }

    return maxLength;
}

int main() {
    int n;
    cout << "Enter number of elements: ";
    cin >> n;

    int arr[n];
    cout << "Enter binary elements (0s and 1s only): ";
    for(int i = 0; i < n; i++)
        cin >> arr[i];

    int result = longestBalancedSubarray(arr, n);

    cout << "Longest balanced subarray length = " << result << endl;

    return 0;
}