#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter number of days: ";
    cin >> n;

    int sales[n];

    cout << "Enter daily sales:\n";
    for(int i = 0; i < n; i++)
    {
        cin >> sales[i];
    }

    bool found = false;

    for(int i = 0; i < n - 2; i++)
    {
        if(sales[i] < sales[i+1] && sales[i+1] < sales[i+2])
        {
            cout << "Restock Alert! Increasing sales from Day "
                 << i+1 << " to Day " << i+3 << endl;

            found = true;
        }
    }

    if(!found)
    {
        cout << "No restock needed." << endl;
    }

    return 0;
}