#include <iostream>
#include <set>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int arr[] = {12, 45, 7, 23, 56, 45, 89, 7, 90};
    int n = sizeof(arr) / sizeof(arr[0]);

    set<int> s;

    // Insert elements into set (removes duplicates)
    for (int i = 0; i < n; i++) {
        s.insert(arr[i]);
    }

    // Convert set to vector
    vector<int> uniqueArray(s.begin(), s.end());

    // Sort (though set already sorted, good practice)
    sort(uniqueArray.begin(), uniqueArray.end());

    if (uniqueArray.size() < 2) {
        cout << "Not enough elements" << endl;
    } else {
        cout << "Second Smallest: " << uniqueArray[1] << endl;
        cout << "Second Largest: " << uniqueArray[uniqueArray.size() - 2] << endl;
    }

    return 0;
}