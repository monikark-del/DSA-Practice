#include <iostream>
using namespace std;

#define MAX 100

int stackArr[MAX];
int top = -1;

// Push into stack
void push(int index) {
    stackArr[++top] = index;
}

// Pop from stack
void pop() {
    if (top >= 0)
        top--;
}

// Check if stack is empty
bool isEmpty() {
    return top == -1;
}

// Get top element
int peek() {
    return stackArr[top];
}

int main() {
    int n;
    int prices[MAX];
    int span[MAX];

    cout << "Enter number of days: ";
    cin >> n;

    cout << "Enter stock prices:\n";
    for (int i = 0; i < n; i++) {
        cin >> prices[i];
    }

    // First day span is always 1
    span[0] = 1;
    push(0);

    for (int i = 1; i < n; i++) {

        while (!isEmpty() && prices[peek()] <= prices[i]) {
            pop();
        }

        if (isEmpty())
            span[i] = i + 1;
        else
            span[i] = i - peek();

        push(i);
    }

    cout << "\nStock Spans:\n";
    for (int i = 0; i < n; i++) {
        cout << span[i] << " ";
    }

    return 0;
}