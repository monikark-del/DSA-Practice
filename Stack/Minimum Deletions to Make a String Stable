#include <stack>
#include <string>
using namespace std;

int minDeletions(string s) {
    stack<char> st;
    int deletions = 0;

    for(char c : s) {
        if(!st.empty() && st.top() == 'B' && c == 'A') {
            // Remove the previous 'B'
            st.pop();
            deletions++;
        } else {
            st.push(c);
        }
    }

    return deletions;
}
