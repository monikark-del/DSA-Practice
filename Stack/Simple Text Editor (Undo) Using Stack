#include <iostream>
using namespace std;

#define MAX 100

string stackArr[MAX];
int top = -1;

// Check if stack is full
bool isFull() {
    return top == MAX - 1;
}

// Check if stack is empty
bool isEmpty() {
    return top == -1;
}

// Push operation
void push(string text) {
    if (isFull()) {
        cout << "Stack Overflow! Cannot add more text.\n";
        return;
    }
    stackArr[++top] = text;
    cout << "Text added successfully!\n";
}

// Pop operation (Undo)
void pop() {
    if (isEmpty()) {
        cout << "Nothing to undo!\n";
        return;
    }
    cout << "Removed text: " << stackArr[top] << endl;
    top--;
}

// Display current text
void displayCurrentText() {
    if (isEmpty()) {
        cout << "Editor is empty.\n";
        return;
    }

    cout << "\n--- Current Text ---\n";
    for (int i = 0; i <= top; i++) {
        cout << stackArr[i] << " ";
    }
    cout << endl;
}

// Stack size
void stackSize() {
    cout << "Stack size: " << (top + 1) << endl;
}

int main() {
    int choice;
    string text;

    do {
        cout << "\n===== Text Editor Menu =====\n";
        cout << "1. Add Text\n";
        cout << "2. Undo Last Text\n";
        cout << "3. View Current Text\n";
        cout << "4. Stack Size\n";
        cout << "5. Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter text: ";
                cin >> text;
                push(text);
                break;
            case 2:
                pop();
                break;
            case 3:
                displayCurrentText();
                break;
            case 4:
                stackSize();
                break;
            case 5:
                cout << "Exiting editor...\n";
                break;
            default:
                cout << "Invalid choice!\n";
        }

    } while (choice != 5);

    return 0;
}