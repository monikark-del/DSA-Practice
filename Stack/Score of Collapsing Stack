#include <stack>
#include <vector>
using namespace std;

int collapsingStackScore(vector<int>& arr) {
    stack<int> st;

    for (int x : arr) {
        st.push(x);

        while (st.size() >= 2) {
            int top1 = st.top(); st.pop();
            int top2 = st.top(); st.pop();

            if (top1 == top2) {
                st.push(top1 + top2);
            } else {
                st.push(top2);
                st.push(top1);
                break;
            }
        }
    }

    int sum = 0;
    while (!st.empty()) {
        sum += st.top();
        st.pop();
    }
    return sum;
}
