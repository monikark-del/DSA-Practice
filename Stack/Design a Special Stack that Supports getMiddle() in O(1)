#include <iostream>
using namespace std;

class Node {
public:
    int data;
    Node* prev;
    Node* next;

    Node(int val) {
        data = val;
        prev = next = NULL;
    }
};

class SpecialStack {
private:
    Node* head;
    Node* mid;
    int count;

public:
    SpecialStack() {
        head = mid = NULL;
        count = 0;
    }

    void push(int val) {
        Node* newNode = new Node(val);

        if (count == 0) {
            head = mid = newNode;
            count = 1;
            return;
        }

        newNode->next = head;
        head->prev = newNode;
        head = newNode;
        count++;

        if (count % 2 != 0) {  // move mid back when odd
            mid = mid->prev;
        }
    }

    void pop() {
        if (count == 0) {
            cout << "Stack is empty\n";
            return;
        }

        Node* temp = head;
        head = head->next;

        if (head != NULL)
            head->prev = NULL;

        count--;

        if (count % 2 == 0 && mid != NULL)
            mid = mid->next;

        delete temp;
    }

    int findMiddle() {
        if (mid == NULL) {
            cout << "Stack is empty\n";
            return -1;
        }
        return mid->data;
    }

    void deleteMiddle() {
        if (count == 0)
            return;

        Node* temp = mid;

        if (mid->prev != NULL)
            mid->prev->next = mid->next;

        if (mid->next != NULL)
            mid->next->prev = mid->prev;

        if (count % 2 == 0)
            mid = mid->next;
        else
            mid = mid->prev;

        count--;
        delete temp;
    }

    void display() {
        Node* temp = head;
        while (temp != NULL) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
};

int main() {
    SpecialStack st;

    st.push(10);
    st.push(20);
    st.push(30);
    st.push(40);
    st.push(50);

    cout << "Stack: ";
    st.display();

    cout << "Middle Element: " << st.findMiddle() << endl;

    st.deleteMiddle();

    cout << "After Deleting Middle: ";
    st.display();

    return 0;
}