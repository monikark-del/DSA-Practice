#include <stack>
#include <string>
using namespace std;

int minPrefixToRemove(string s) {
    stack<char> st;
    int removeUpto = 0;

    for (int i = 0; i < s.size(); i++) {
        if (s[i] == '(') {
            st.push('(');
        } 
        else if (s[i] == ')') {
            if (!st.empty()) {
                st.pop();
            } else {
                // invalid closing bracket
                removeUpto = i + 1;
            }
        }
    }

    // If unmatched '(' remain, entire string after removal is invalid
    if (!st.empty()) return s.size();

    return removeUpto;
}
