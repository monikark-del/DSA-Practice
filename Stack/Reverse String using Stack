#include <iostream>
#include <stack>
using namespace std;

int main() {
    string str = "HELLO WORLD";
    stack<char> s;

    // Push characters into stack
    for (char ch : str) {
        s.push(ch);
    }

    // Pop and form reversed string
    string reversed = "";
    while (!s.empty()) {
        reversed += s.top();
        s.pop();
    }

    cout << "Original String: " << str << endl;
    cout << "Reversed String: " << reversed << endl;

    return 0;
}